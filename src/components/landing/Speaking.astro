---
// Speaking & Training section
const engagements = [
  {
    institution: 'CAMP IT Conferences',
    course: 'AI / Data Innovation Strategies — Chicago (Rosemont/O’Hare), Illinois',
    topic: 'Engineering at the Speed of AI: Talent Density and the New Engineering Advantage',
    description: 'A conference session on how AI is changing the economics of engineering, why talent density is becoming a strategic differentiator, and how technology leaders can build more responsive, future-ready teams.',
    date: 'July 16, 2026',
    type: 'Conference Talk',
    url: 'https://campitsince1984.com/upcoming-on-site-events/upcoming-on-site-events-aidatainnovation071626/',
  },
  {
    institution: 'University of Michigan',
    course: 'EECS 441 — Mobile App Development for Entrepreneurs',
    topic: 'Engineering at the Speed of AI',
    description: 'How AI tools reshape software development workflows and what that means for the next generation of engineers.',
    type: 'Guest Lecture',
  },
];
---

<section aria-labelledby="speaking-heading" class="space-y-4">
  <div class="badge badge-secondary badge-outline">Speaking &amp; Training</div>
  <h2 id="speaking-heading" class="text-2xl font-bold">Talks &amp; Training</h2>

  <div class="space-y-3">
    {engagements.map((eng) => (
      <div class="card bg-base-200 border border-base-300">
        <div class="card-body py-4">
          <div class="flex items-start justify-between gap-3">
            <div>
              <!-- Institution name with accent color -->
              <p class="font-semibold text-primary">{eng.institution}</p>
              <p class="text-sm text-base-content/60 mt-0.5">
                {eng.course}{eng.date && <> · {eng.date}</>}
              </p>
              <!-- Topic with accent color to draw the eye -->
              <p class="text-sm text-accent font-medium mt-2">
                &ldquo;{
                  eng.url ? (
                    <a href={eng.url} target="_blank" rel="noopener noreferrer" class="link link-hover">
                      {eng.topic}
                    </a>
                  ) : (
                    eng.topic
                  )
                }&rdquo;
              </p>
              <p class="text-sm text-base-content/70 mt-1">{eng.description}</p>
            </div>
            <span class="badge badge-primary badge-sm shrink-0 mt-0.5">{eng.type}</span>
          </div>
        </div>
      </div>
    ))}
  </div>

  <p class="text-sm text-base-content/60">
    Available for conference talks, engineering team workshops, and guest lectures.
  </p>
</section>
